# Postgres con PostGIS. En Supabase: Project settings -> Database -> Connection string (modo sesion).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/subastas

# Fondo del mapa: URL de un estilo completo de MapLibre (teselas, letras e
# iconos). Por defecto, Liberty de OpenFreeMap: publico, sin clave, sin limite
# de visitas y con uso comercial permitido. Otras opciones del mismo servicio:
# .../styles/bright, .../styles/positron. Para MapTiler o un Protomaps propio,
# pon aqui la URL de su estilo; tiene que traer "glyphs" o el mapa se queda en blanco.
NEXT_PUBLIC_ESTILO_MAPA=https://tiles.openfreemap.org/styles/liberty

# Fuente para las etiquetas de los grupos. Tiene que existir en los glifos del
# estilo elegido. Liberty trae Noto Sans en regular, cursiva y negrita.
NEXT_PUBLIC_FUENTE_MAPA=Noto Sans Regular

# Enlaces magicos de acceso. Sin API key, los enlaces se imprimen por consola.
RESEND_API_KEY=
CORREO_REMITENTE=acceso@tudominio.es
URL_BASE=http://localhost:3000

# Conexiones de la pool por instancia. En serverless conviene dejarlo bajo y
# usar una cadena con pooler (pgbouncer) delante.
DB_MAX_CONEXIONES=2

# Transporte de la conexión: "tcp" (por defecto) o "neon-ws" para ir por
# WebSocket sobre el 443, en entornos donde el 5432 está cerrado.
DB_DRIVER=tcp
