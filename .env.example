# Postgres con PostGIS. En Supabase: Project settings -> Database -> Connection string (modo sesion).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/subastas

# Teselas del mapa. OpenStreetMap solo vale para desarrollo: su politica de uso
# prohibe trafico de produccion. En produccion, MapTiler o Protomaps propio.
NEXT_PUBLIC_TESELAS=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TESELAS_ATRIBUCION=&copy; OpenStreetMap

# Enlaces magicos de acceso. Sin API key, los enlaces se imprimen por consola.
RESEND_API_KEY=
CORREO_REMITENTE=acceso@tudominio.es
URL_BASE=http://localhost:3000

# Glifos del mapa: hacen falta para las etiquetas, incluso con teselas raster.
# El servidor de demostracion de MapLibre vale para desarrollo; en produccion,
# el del mismo proveedor que las teselas.
NEXT_PUBLIC_GLIFOS=https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf
NEXT_PUBLIC_FUENTE_MAPA=Noto Sans Regular

# Conexiones de la pool por instancia. En serverless conviene dejarlo bajo y
# usar una cadena con pooler (pgbouncer) delante.
DB_MAX_CONEXIONES=2
