{
  "name": "subastapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node --import tsx scripts/worker-mapa.ts",
    "dev": "next dev",
    "prebuild": "node --import tsx scripts/worker-mapa.ts",
    "build": "next build",
    "start": "next start",
    "tipos": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrar": "node --env-file-if-exists=.env --import tsx scripts/migrar.ts",
    "db:semilla": "node --env-file-if-exists=.env --import tsx scripts/semilla.ts",
    "ingesta": "node --env-file-if-exists=.env --import tsx src/ingesta/ejecutar.ts",
    "acceso": "node --env-file-if-exists=.env --import tsx scripts/enlace.ts",
    "db:estado": "node --env-file-if-exists=.env --import tsx scripts/comprobar.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "fast-xml-parser": "5.11.2",
    "maplibre-gl": "6.15.0",
    "next": "^15.5.27",
    "pg": "8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ws": "^8.18.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/ws": "^8.5.13",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  }
}
